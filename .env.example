# Agent Office Environment Variables
# Copy this file to .env and uncomment variables as needed.
# .env is gitignored. The standalone server loads it automatically when present.

# Enable verbose debug logging for hook events (SessionStart, SessionEnd, Stop, etc.)
PIXEL_AGENTS_DEBUG=1

# Standalone browser dashboard configuration.
# Use 127.0.0.1 for local-only access. Use 0.0.0.0 only behind a trusted LAN,
# VPN, built-in auth, or an access-controlled tunnel/reverse proxy.
# AGENT_OFFICE_HOST=127.0.0.1
# AGENT_OFFICE_PORT=4627

# Optional built-in HTTP Basic auth. Leave unset for localhost-only use.
# If AGENT_OFFICE_AUTH_PASSWORD is set, every route, API call, and SSE stream
# requires a browser login prompt.
# AGENT_OFFICE_AUTH_USER=agent-office
# AGENT_OFFICE_AUTH_PASSWORD=change-this-long-random-password

# Optional scanner tuning.
# AGENT_OFFICE_POLL_INTERVAL_MS=1500
# AGENT_OFFICE_ACTIVE_GRACE_MS=7000
