{
  "name": "agent-office",
  "displayName": "Agent Office",
  "description": "Watch Codex, Claude, Grok, OpenCode, Antigravity, and Goose work in a shared browser office for WSL and Windows",
  "version": "1.3.0",
  "publisher": "falkoro",
  "repository": {
    "type": "git",
    "url": "https://github.com/falkoro/agent-office"
  },
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pixel-agents.showPanel",
        "title": "Agent Office: Show Panel"
      },
      {
        "command": "pixel-agents.exportDefaultLayout",
        "title": "Agent Office: Export Layout as Default"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "pixel-agents-panel",
          "title": "Agent Office",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "pixel-agents-panel": [
        {
          "type": "webview",
          "id": "pixel-agents.panelView",
          "name": "Agent Office"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build:webview": "cd webview-ui && npm run build",
    "compile": "npm run check-types && npm run lint && node esbuild.js && npm run build:webview",
    "build": "npm run compile && npm run build:standalone",
    "build:standalone": "node standalone/esbuild.cjs",
    "start:standalone": "bun standalone/server.ts",
    "start:standalone:node": "node dist/standalone/server.js",
    "verify:standalone": "node scripts/verify-standalone.cjs",
    "install:wsl-service": "bash scripts/install-wsl-service.sh",
    "uninstall:wsl-service": "bash scripts/uninstall-wsl-service.sh",
    "install:windows-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-service.ps1",
    "uninstall:windows-service": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows-service.ps1",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && npm run build:webview",
    "check-types": "tsc --noEmit && tsc --noEmit -p server/tsconfig.test.json",
    "prepare": "husky",
    "lint": "eslint src server shared && cd webview-ui && eslint .",
    "lint:fix": "eslint src server shared --fix && cd webview-ui && eslint . --fix",
    "import-tileset": "tsx scripts/import-tileset-cli.ts",
    "format": "prettier --write \"src/**/*.ts\" \"server/**/*.ts\" \"shared/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"server/**/*.ts\" \"shared/**/*.ts\" \"webview-ui/src/**/*.{ts,tsx,css}\" \"*.{js,mjs}\" \"webview-ui/*.{js,ts}\"",
    "test:webview": "cd webview-ui && npm test",
    "test:server": "cd server && npm test",
    "test": "npm run test:webview && npm run test:server",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "knip": "knip"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "25.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.105.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint --fix",
    "server/**/*.ts": "eslint --fix",
    "shared/**/*.ts": "eslint --fix",
    "webview-ui/src/**/*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write",
    "webview-ui/**/*.{ts,tsx,js,css,json}": "prettier --write"
  }
}
